FROM python:3.11-slim

RUN apt-get update -y && apt-get install -y --no-install-recommends \
    graphviz \
    && apt-get dist-clean

WORKDIR /app

COPY src/spectroscopy_bluesky/common/queue_service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/spectroscopy_bluesky/ ./src/spectroscopy_bluesky/

ENV PYTHONPATH=/app/src

RUN python -c "import daq_queuing_service; print(daq_queuing_service.__file__)"
CMD ["python","-m","daq_queuing_service","--config","./src/spectroscopy_bluesky/common/queue_service/p51/test_daq_queue_config.yaml","-p","8001","--dev"]
