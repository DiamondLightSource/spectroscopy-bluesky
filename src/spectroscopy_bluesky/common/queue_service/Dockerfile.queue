FROM python:3.11-slim
ARG VERSION=0.0.1

RUN apt-get update -y && apt-get install -y --no-install-recommends \
    graphviz \
    && apt-get dist-clean

WORKDIR /app

COPY src/spectroscopy_bluesky/common/queue_service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/spectroscopy_bluesky/ ./src/spectroscopy_bluesky/

RUN printf '__version__ = "%s"\n' "$VERSION" \
    > ./src/spectroscopy_bluesky/_version.py

ENV PYTHONPATH=/app/src

CMD ["python","-m","daq_queuing_service","--config","./src/spectroscopy_bluesky/common/queue_service/test/test_daq_queue_config.yaml","-p","8001","--dev"]
